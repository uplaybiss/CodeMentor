# =============================================================================
# EduAgent — environment configuration
# Copy this file to `.env` and fill in real values. Nothing here is secret in
# default form; the app boots with safe defaults for all values below.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=EduAgent
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
# Comma-separated list of origins allowed by CORS
APP_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000

# --- LLM ---------------------------------------------------------------------
# Provider can be "openai" or "gemini". Every agent reads this setting at
# runtime, so switching providers is a one-line config change.
# Provider can be "openai", "gemini" or "demo". "demo" runs the whole system
# offline with a deterministic tutor — no API key required (ideal for CI/try-it).
LLM_PROVIDER=openai
LLM_OPENAI_API_KEY=sk-...
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_TEMPERATURE=0.4
LLM_GEMINI_API_KEY=AIza...
LLM_GEMINI_MODEL=gemini-1.5-flash
LLM_GEMINI_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Database (SQLite by default; point DATABASE_URL anywhere SQLAlchemy) ----
DATABASE_URL=sqlite:///./data/edueagent.db
DATABASE_ECHO=false
DATABASE_CREATE_ON_STARTUP=true

# --- Vector store (ChromaDB) --------------------------------------------------
VECTOR_PERSIST_DIRECTORY=./data/chroma
VECTOR_COLLECTION_NAME=edueagent_notes
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_CHUNK_SIZE=600
VECTOR_CHUNK_OVERLAP=100
VECTOR_TOP_K=4

# --- API ----------------------------------------------------------------------
API_PREFIX=/api/v1
API_UPLOAD_DIR=./data/uploads
API_PAGINATION_DEFAULT_SIZE=20

# --- Logging ------------------------------------------------------------------
LOGGING_LEVEL=INFO
LOGGING_JSON_FORMAT=false
LOGGING_LOG_DIR=./logs

# --- Frontend -----------------------------------------------------------------
FRONTEND_API_BASE_URL=http://localhost:8000
