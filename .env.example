# CodeMentor: safe local Demo defaults. No real credentials in this file.
# demo.local forces Demo provider, disables RAG and selects its --data-dir.
APP_NAME=CodeMentor
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8013
APP_DEBUG=false
APP_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Use demo without keys. Real providers require your own supported model and key.
# The model strings below reflect existing code defaults; not a live-model test.
LLM_PROVIDER=demo
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_TEMPERATURE=0.4
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-1.5-flash
LLM_GEMINI_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

DATABASE_URL=sqlite:///./data/local_demo/codementor.sqlite
DATABASE_ECHO=false
DATABASE_CREATE_ON_STARTUP=true

# Optional RAG is off. Enabling it requires the full dependencies and models.
VECTOR_ENABLED=false
VECTOR_PERSIST_DIRECTORY=./data/chroma
VECTOR_COLLECTION_NAME=codementor_notes
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_CHUNK_SIZE=600
VECTOR_CHUNK_OVERLAP=100
VECTOR_TOP_K=4

API_PREFIX=/api/v1
API_UPLOAD_DIR=./data/uploads
API_PAGINATION_DEFAULT_SIZE=20

LOGGING_LEVEL=INFO
LOGGING_JSON_FORMAT=false
LOGGING_LOG_DIR=./logs
LOGGING_ROTATION_BYTES=5242880
LOGGING_BACKUP_COUNT=3

# Export this in the Streamlit terminal; frontend reads process environment.
FRONTEND_API_BASE_URL=http://127.0.0.1:8013

HARNESS_CONTEXT_TOKENS=512
HARNESS_RECENT_MISTAKES=3
HARNESS_RECENT_RECORDS=3
HARNESS_MAX_TOOL_CALLS=40
HARNESS_MAX_REPEAT_CALLS=2
HARNESS_TOOL_TIMEOUT_SECONDS=10
HARNESS_READONLY_RETRIES=1
HARNESS_RECURSION_LIMIT=20
# Blank derives the path beside DATABASE_URL. demo.local sets its own path.
HARNESS_CHECKPOINT_PATH=

# Keep external tracing and model downloads off for local Demo/tests.
ANONYMIZED_TELEMETRY=False
HF_HUB_OFFLINE=1
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Export this when running pytest directly from the project root.
TIKTOKEN_CACHE_DIR=demo/token_cache
